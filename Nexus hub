local MinimizedBar = Instance.new("TextButton")

MinimizedBar.Name = "MinimizedBar"
MinimizedBar.Size = UDim2.fromOffset(330,42)
MinimizedBar.Position = UDim2.new(0.5, 0, 0, 45)
MinimizedBar.AnchorPoint = Vector2.new(0.5, 0)
MinimizedBar.BackgroundColor3 = Theme.Background
MinimizedBar.BorderSizePixel = 0
MinimizedBar.Text = "⚡ NEXUS HUB | PREMIUM FREE SCRIPT"
MinimizedBar.TextColor3 = Theme.White
MinimizedBar.Font = Enum.Font.GothamMedium
MinimizedBar.TextSize = 11
MinimizedBar.Visible = false
MinimizedBar.AutoButtonColor = false
MinimizedBar.Parent = ScreenGui

Corner(MinimizedBar,8)
WhiteStroke(MinimizedBar)

local function UpdateMinimizedBar()
    Camera = workspace.CurrentCamera

    if not Camera then
        return
    end

    local screenWidth = Camera.ViewportSize.X
    local width = math.max(180, math.min(330, screenWidth - 16))

    MinimizedBar.Size = UDim2.fromOffset(width, 42)

    if screenWidth < 300 then
        MinimizedBar.TextSize = 7
    elseif screenWidth < 380 then
        MinimizedBar.TextSize = 9
    else
        MinimizedBar.TextSize = 11
    end
end

UpdateMinimizedBar()

if Camera then
    Camera:GetPropertyChangedSignal("ViewportSize"):Connect(UpdateMinimizedBar)
end

local MinimizedDragging = false
local MinimizedDragStart
local MinimizedStartPos

MinimizedBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        MinimizedDragging = true
        MinimizedDragStart = input.Position
        MinimizedStartPos = MinimizedBar.AbsolutePosition

        MinimizedBar.AnchorPoint = Vector2.new(0, 0)
        MinimizedBar.Position = UDim2.fromOffset(MinimizedStartPos.X, MinimizedStartPos.Y)

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                MinimizedDragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if MinimizedDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local Delta = input.Position - MinimizedDragStart
        MinimizedBar.Position = UDim2.fromOffset(
            MinimizedStartPos.X + Delta.X,
            MinimizedStartPos.Y + Delta.Y
        )
    end
end)

Minimize.MouseButton1Click:Connect(function()
    MainFrame.Visible = false
    MinimizedBar.Visible = true
    UpdateMinimizedBar()
end)

MinimizedBar.MouseButton1Click:Connect(function()
    if MinimizedDragging then return end

    MinimizedBar.Visible = false
    MainFrame.Visible = true
    UpdateMobileScale()
end)


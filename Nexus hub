-- MOBILE SCALE
--==================================================

local MainScale = Instance.new("UIScale")

MainScale.Scale = 1
MainScale.Parent = MainFrame

local Camera = workspace.CurrentCamera

local function UpdateMobileScale()
    Camera = workspace.CurrentCamera

    if not Camera then
        return
    end

    local viewport = Camera.ViewportSize

    local widthScale = (viewport.X - 16) / 800
    local heightScale = (viewport.Y - 16) / 500

    local scale = math.min(widthScale, heightScale, 1)

    MainScale.Scale = math.max(scale, 0.35)
end

UpdateMobileScale()

if Camera then
    Camera:GetPropertyChangedSignal("ViewportSize"):Connect(UpdateMobileScale)
end


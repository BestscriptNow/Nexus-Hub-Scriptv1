--==================================================
-- SEARCH FILTER
--==================================================

SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
    local search = string.lower(SearchBox.Text)

    for _, child in ipairs(ScriptList:GetChildren()) do
        if child:IsA("Frame") and child.Name == "ScriptCard" then
            local nameLabel = child:FindFirstChild("ScriptName")
            if nameLabel then
                local name = string.lower(nameLabel.Text)
                child.Visible = (search == "" or string.find(name, search, 1, true) ~= nil)
            end
        end
    end
end)


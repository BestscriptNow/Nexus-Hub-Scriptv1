local function ApplyTheme(name)
    local data = Themes[name]

    if not data then
        return
    end

    CurrentThemeName = name

    Theme.Accent = data.Accent
    Theme.AccentDark = data.AccentDark
    Theme.Glow = data.Glow
    Theme.Border = data.Border

    TitleLine.BackgroundColor3 = Theme.Accent

    if LoadingBar then
        LoadingBar.BackgroundColor3 = Theme.Accent
    end

    for themeName,choice in pairs(ThemeChoices) do
        local active = themeName == name

        choice.BackgroundColor3 = active and Theme.AccentDark or Theme.Background2
        choice.TextColor3 = active and Theme.White or Theme.Silver

        ThemeStroke(choice)
    end

    for _,obj in ipairs(ScreenGui:GetDescendants()) do
        if obj:IsA("UIStroke") then
            obj.Color = Theme.Border
        end
    end

    for _,obj in ipairs(ScreenGui:GetDescendants()) do
        if obj:IsA("Frame") and obj.Name == "AccentLine" then
            obj.BackgroundColor3 = Theme.Accent
        end
    end
end

for name,choice in pairs(ThemeChoices) do
    choice.MouseButton1Click:Connect(function()
        ApplyTheme(name)
    end)
end


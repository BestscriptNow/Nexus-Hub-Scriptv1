--==================================================
-- FPS / PING MONITOR
--==================================================

local Frames = 0
local FPS = 0
local FPSTimer = 0

RunService.RenderStepped:Connect(function(dt)
    Frames += 1
    FPSTimer += dt

    if FPSTimer >= 0.5 then
        FPS = math.floor(Frames / FPSTimer)
        Frames = 0
        FPSTimer = 0

        local ping = 0

        pcall(function()
            ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
        end)

        StatusLabel.Text = "FPS: "..FPS.."  |  Ping: "..ping.."ms"
    end
end)

--==================================================
-- RIGHT CONTROL TOGGLE
--==================================================

UserInputService.InputBegan:Connect(function(input,processed)
    if processed then
        return
    end

    if input.KeyCode == Enum.KeyCode.RightControl then
        if MainFrame.Visible then
            MainFrame.Visible = false
            MinimizedBar.Visible = true
        else
            MinimizedBar.Visible = false
            MainFrame.Visible = true
            UpdateMobileScale()
        end
    end
end)

--==================================================
-- INITIALIZATION SEQUENCE
--==================================================

task.spawn(function()
    local steps = {
        {25,"Loading interface..."},
        {50,"Loading scripts..."},
        {75,"Preparing dashboard..."},
        {100,"NEXUS HUB ready!"}
    }

    for _,step in ipairs(steps) do
        local percent = step[1]
        local status = step[2]

        LoadingStatus.Text = status
        LoadingPercent.Text = percent.."%"

        Tween(LoadingBar, 0.35, {
            Size = UDim2.new(percent/100, 0, 1, 0)
        })

        task.wait(0.35)
    end

    task.wait(0.35)

    Tween(LoadingFrame, 0.3, {
        BackgroundTransparency = 1
    })

    for _,obj in ipairs(LoadingFrame:GetDescendants()) do
        if obj:IsA("TextLabel") then
            Tween(obj, 0.25, { TextTransparency = 1 })
        elseif obj:IsA("Frame") then
            Tween(obj, 0.25, { BackgroundTransparency = 1 })
        elseif obj:IsA("UIStroke") then
            Tween(obj, 0.25, { Transparency = 1 })
        end
    end

    task.wait(0.35)

    LoadingFrame:Destroy()
    MainFrame.Visible = true
    SelectTab("Home")
    ApplyTheme("Night Blue")
    UpdateMobileScale()
end)
